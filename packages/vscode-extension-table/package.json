{
  "name": "ataula-personal",
  "displayName": "Galastri Ataula",
  "description": "Edição de tabelas de texto com bordas simples, células multilinha e ajuste automático. Versão pessoal de Ataula.",
  "version": "1.0.15",
  "publisher": "andregalastri",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/andregalastri/Ataula"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "edumark",
        "aliases": [
          "EduMark",
          "edumark"
        ],
        "extensions": [
          ".edu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "edumark",
        "scopeName": "source.edu",
        "path": "./syntaxes/edumark.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ataula.tableEnter",
        "title": "Inserir linha dentro da célula",
        "category": "Galastri Ataula"
      },
      {
        "command": "ataula.tableTab",
        "title": "Aplicar alterações na estrutura da tabela",
        "category": "Galastri Ataula"
      },
      {
        "command": "ataula.selectCellContent",
        "title": "Selecionar conteúdo da célula",
        "category": "Galastri Ataula"
      },
      {
        "command": "ataula.convertToMarkdown",
        "title": "Converter tabela para Markdown",
        "category": "Galastri Ataula"
      },
      {
        "command": "ataula.convertToAtaula",
        "title": "Converter tabela Markdown para Galastri Ataula",
        "category": "Galastri Ataula"
      },
      {
        "command": "ataula.reformatTable",
        "title": "Refazer formatação",
        "category": "Galastri Ataula"
      },
      {
        "command": "ataula.extendTable",
        "title": "Estender tabela para apresentação",
        "category": "Galastri Ataula"
      }
    ],
    "keybindings": [
      {
        "command": "ataula.tableEnter",
        "key": "enter",
        "when": "editorTextFocus && ataula.canEditTable && !editorHasMultipleSelections"
      },
      {
        "command": "ataula.tableTab",
        "key": "oem_5",
        "when": "editorTextFocus && ataula.canEditTable && !editorHasMultipleSelections"
      },
      {
        "command": "ataula.reformatTable",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+shift+f",
        "when": "editorTextFocus && ataula.canEditTable && !editorHasMultipleSelections"
      }
    ],
    "configuration": {
      "title": "Galastri Ataula",
      "properties": {
        "galastriAtaula.finishColumn": {
          "type": "integer",
          "default": 80,
          "minimum": 1,
          "markdownDescription": "Posição final da borda direita da tabela externa ao executar **Estender tabela para apresentação**. Inclui indentação e prefixos de comentário/citação. Tabelas internas ocupam o espaço disponível na célula do pai. A expansão é pontual e não altera o conteúdo nem quebra linhas."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx esbuild ./src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=./dist/extension.js",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npx --yes @vscode/vsce package --no-dependencies --out galastri-ataula.vsix"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@edumark/shared": "*",
    "@edumark/table-engine": "*"
  }
}
