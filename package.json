{
  "name": "ataula-monorepo",
  "version": "1.0.6",
  "description": "Galastri Ataula — versão pessoal do editor de tabelas para VS Code",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:props": "vitest run packages/table-engine/src/__tests__/parser.props.test.ts",
    "test:e2e": "npm run test:integration",
    "vscode:prepublish": "npm run compile --workspace=packages/vscode-extension-table",
    "test:integration": "npm run build && npm run vscode:prepublish && node scripts/run-integration.cjs",
    "build": "tsc -b --force",
    "package:vsix": "npm run build && npm run package:vsix --workspace=packages/vscode-extension-table"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vscode/test-electron": "^2.5.2",
    "fast-check": "^4.8.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "mocha": "^10.7.3"
  }
}
